+            elif status == 200:
+                have = 0  # server ignored Range, a complete overwrite is required
+            else:
+                raise RuntimeError(f'unexpected HTTP status {status}')
+            new_meta = {'url': url, 'etag': r.headers.get('ETag') or '',
+                        'last_modified': r.headers.get('Last-Modified') or ''}
+            atomic_write_json(sidecar, new_meta)
+            base = have
+            total = ((base + content_len) if content_len is not None else hint)
+            received = 0
+            try:
+                with dest.open('ab' if have else 'wb') as stream:
+                    while True:
+                        if cancelled.is_set():
+                            raise DownloadCancelled()
+                        block = r.read(chunk_size)
+                        if not block:
+                            break
+                        stream.write(block)
+                        received += len(block)
+                        progress('Downloading', base + received, total)
+                if expected_bytes is not None and received != expected_bytes:
+                    raise RuntimeError(f'download truncated ({received} of {expected_bytes} bytes)')
+            except OSError as exc:
+                if exc.errno == errno.ENOSPC:
+                    raise RuntimeError('no space left on device while downloading') from None
+                raise
+            sidecar.unlink(missing_ok=True)
+            return
+    raise RuntimeError('could not safely resume download; retry from scratch')
diff --git a/drstool_core/lutris_config_scan.py b/drstool_core/lutris_config_scan.py
new file mode 100644
index 0000000..f348776
--- /dev/null
+++ b/drstool_core/lutris_config_scan.py
@@ -0,0 +1,58 @@
+"""Bounded, metadata-cached Lutris game config discovery without Qt.
+
+The caller can run this in a background thread. Files are parsed only when
+(path, mtime, ctime, inode, size) changes; deletions are removed from the cache.
+"""
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Callable
+
+import yaml
+
+_LOG = logging.getLogger(__name__)
+_LOADER = getattr(yaml, 'CSafeLoader', yaml.SafeLoader)
+
+
+def scan_game_configs(folder: Path, cached: dict | None = None,
+                      cancelled: Callable[[], bool] = lambda: False) -> tuple[list, dict]:
+    """Return rows [(path, slug, display_name, runner)] and new cache.
+
+    Malformed YAML is skipped, not fatal; caller can request a full scan by
+    passing an empty cache. The scan never follows symlinks to game configs.
+    """
+    folder = Path(folder)
+    if not folder.is_dir():
+        raise FileNotFoundError(f'Folder not found: {folder}')
+    cache_in = cached or {}
+    cache_out = {}
+    rows = []
+    paths = sorted(folder.glob('*.yml')) + sorted(folder.glob('*.yaml'))
+    for path in paths:
+        if cancelled():
+            break
+        try:
+            if path.is_symlink():
+                continue
+            st = path.stat()
+            signature = (st.st_mtime_ns, st.st_ctime_ns, st.st_size, st.st_ino)
+            previous = cache_in.get(str(path))
+            if previous is not None and previous[0] == signature:
+                row = previous[1]
+            else:
+                with path.open('r', encoding='utf-8') as file:
+                    data = yaml.load(file, Loader=_LOADER) or {}
+                if not isinstance(data, dict):
+                    continue
+                game = data.get('game')
+                game = game if isinstance(game, dict) else {}
+                exe = str(game.get('exe') or '')
+                system = data.get('system')
+                runner = str(system.get('runner') or '') if isinstance(system, dict) else ''
+                row = (path.stem, Path(exe).stem if exe else path.stem, runner)
+            cache_out[str(path)] = (signature, row)
+            rows.append((path, *row))
+        except Exception:
+            _LOG.debug('Lutris YAML scan skipped: %s', path, exc_info=True)
+    return rows, cache_out
diff --git a/drstool_core/yaml_merge.py b/drstool_core/yaml_merge.py
new file mode 100644
index 0000000..0d526d0
--- /dev/null
+++ b/drstool_core/yaml_merge.py
@@ -0,0 +1,71 @@
+"""Lutris YAML merge that preserves user comments, quotes and unrelated keys.
+
+Qt-free so the exact write plan can be regression-tested without a GUI.
+"""
+from __future__ import annotations
+
+import io
+from typing import Any
+
+
+def merge_lutris_yaml(original_text: str, system_keys: dict[str, Any],
+                      env_vars: dict[str, str], owned: dict | None = None):
+    """Return (updated text, system added/changed, env added/changed,
+    system removed, env removed), touching only requested or owned keys.
+
+    If the round-trip YAML library is not installed, never silently discard
+    comments or quote styles. In that case the caller is told to install it.
+    """
+    try:
+        from ruamel.yaml import YAML
+    except ImportError as exc:
+        raise RuntimeError('Editing Lutris YAML requires ruamel.yaml to preserve '
+                           'comments and quote styles') from exc
+    parser = YAML(typ='rt')
+    parser.preserve_quotes = True
+    parser.width = 1_000_000
+    doc = parser.load(original_text) or {}
+    if not isinstance(doc, dict):
+        raise ValueError("the game's YAML top level is not a mapping")
+    if not isinstance(doc.get('system'), dict):
+        doc['system'] = {}
+    system = doc['system']
+    owned = owned or {}
+
+    sys_removed = set()
+    for key, previous in owned.get('system', {}).items():
+        if key not in system_keys and key in system and system[key] == previous:
+            del system[key]
+            sys_removed.add(key)
+    sys_changed = set()
+    for key, value in system_keys.items():
+        if key in system and system[key] == value and type(system[key]) is type(value):
+            continue
+        system[key] = value
+        sys_changed.add(key)
+
+    env = system.get('env')
+    if not isinstance(env, dict):
+        # Do not fabricate an env object if there is nothing to set.
+        env = {}
+        if env_vars:
+            system['env'] = env
+    env_removed = set()
+    for key, previous in owned.get('env', {}).items():
+        if key not in env_vars and key in env and str(env[key]) == str(previous):
+            del env[key]
+            env_removed.add(key)
+    env_changed = set()
+    for key, value in env_vars.items():
+        if key in env and str(env[key]) == str(value):
+            continue
+        env[key] = str(value)
+        env_changed.add(key)
+    if not env and isinstance(system.get('env'), dict):
+        del system['env']
+
+    if not (sys_changed or env_changed or sys_removed or env_removed):
+        return original_text, sys_changed, env_changed, sys_removed, env_removed
+    result = io.StringIO()
+    parser.dump(doc, result)
+    return result.getvalue(), sys_changed, env_changed, sys_removed, env_removed
