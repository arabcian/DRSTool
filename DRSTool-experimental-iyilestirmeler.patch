+    def test_sorted_by_severity(self):
+        issues = lint_config({"DXVK_ASYNC": "1", "PROTON_ENABLE_NVAPI": "1", "PROTON_DISABLE_NVAPI": "1"},
+                             {}, "", False, {}, False)
