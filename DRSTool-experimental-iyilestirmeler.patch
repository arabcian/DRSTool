-{
-    init_config();
-
-    auto* chain = (VkLayerInstanceCreateInfo*)pCreateInfo->pNext;
-    while (chain && !(chain->sType == VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO &&
-                      chain->function == VK_LAYER_LINK_INFO))
