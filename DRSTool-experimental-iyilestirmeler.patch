-LOG_LEVEL=WARN
+# cpuset.cpus.partition type: "member", "root" or "isolated".
+# theGood must be a partition root ("root" or "isolated") for the isolation to
+# be real: only a valid partition root takes EXCLUSIVE ownership of its CPUs,
+# which is what stops root-cgroup strays from being scheduled on the game's CCD.
+# theUgly should normally stay "member". If BOTH groups claim their CPUs
+# exclusively, the root cgroup can be left with no CPUs at all and the kernel
+# silently marks the partition "root invalid" — the cgroups still exist and
+# still look configured, but nothing is actually isolated. Check with:
+#   lutris-game-tune-wrapper STATUS   (look for "partition: root", not "invalid")
+CCD_GOOD_PARTITION_TYPE=root
+CCD_UGLY_PARTITION_TYPE=member
