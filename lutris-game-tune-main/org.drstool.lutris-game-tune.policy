<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  lutris-game-tune without a setuid binary ("polkit" install mode).

  Lutris runs   pkexec /usr/local/bin/lutris-game-tune-wrapper PRE   before a game
  and           pkexec /usr/local/bin/lutris-game-tune-wrapper POST  after it.
  The user sitting at the machine (active local session) is allowed without a
  password, exactly what the setuid bit used to grant - but remote (ssh) and
  inactive sessions now need an administrator password, which setuid never asked.

  The wrapper itself only accepts PRE [profile] / POST / STATUS / RESTORE /
  DRYRUN [profile]; RUN refuses to work as root, so pkexec cannot be used to
  start a game as root. RUN works without pkexec through the cap_sys_nice file
  capability (see install.sh - -polkit).
-->
<policyconfig>
  <vendor>DRSTool</vendor>
  <vendor_url>https://github.com/arabcian/DRSTool</vendor_url>
  <icon_name>drstool</icon_name>

  <action id="org.drstool.lutris-game-tune">
    <description>Apply or restore gaming system tuning (lutris-game-tune)</description>
    <message>Authentication is required to change system settings for a game</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/lutris-game-tune-wrapper</annotate>
  </action>
</policyconfig>
