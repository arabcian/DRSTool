-static void snapshot_env() {
-    for (char** e = environ; e && *e; ++e) {
-        if (strncmp(*e, "FLM_", 4) != 0) continue;
-        const char* eq = strchr(*e, '=');
-        if (!eq) continue;
-        g_env_snapshot.emplace_back(std::string(*e, (size_t)(eq - *e)), eq + 1);
-    }
-}
